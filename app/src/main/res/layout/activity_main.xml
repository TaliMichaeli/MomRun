<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    tools:context=".MainActivity">

    <!-- MARK: Lives -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main_LAY_lives"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="@dimen/default_margin">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_life0"
            android:layout_width="@dimen/life_dimens"
            android:layout_height="@dimen/life_dimens"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/pacifier" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_life1"
            android:layout_width="@dimen/life_dimens"
            android:layout_height="@dimen/life_dimens"
            android:layout_marginHorizontal="@dimen/default_margin"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/pacifier" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_life2"
            android:layout_width="@dimen/life_dimens"
            android:layout_height="@dimen/life_dimens"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/pacifier" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- MARK: Controls -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main_LAY_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/default_margin">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/main_FAB_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/move_left"
            app:srcCompat="@drawable/arrow_left" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/main_FAB_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/move_right"
            app:srcCompat="@drawable/arrow_right" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- MARK: Game grid -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_LAY_lives"
        android:layout_above="@id/main_LAY_controls"
        android:layout_marginHorizontal="@dimen/default_margin"
        android:orientation="vertical">

        <!-- Row 0 -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_0_0" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_0_1" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_0_2" style="@style/GridCell" app:srcCompat="@drawable/poop" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 1 -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_1_0" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_1_1" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_1_2" style="@style/GridCell" app:srcCompat="@drawable/poop" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 2 -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_2_0" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_2_1" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_2_2" style="@style/GridCell" app:srcCompat="@drawable/poop" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 3 -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_3_0" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_3_1" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_3_2" style="@style/GridCell" app:srcCompat="@drawable/poop" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 4 -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_4_0" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_4_1" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_4_2" style="@style/GridCell" app:srcCompat="@drawable/poop" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 5 -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_5_0" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_5_1" style="@style/GridCell" app:srcCompat="@drawable/poop" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_obstacle_5_2" style="@style/GridCell" app:srcCompat="@drawable/poop" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Player row -->
        <androidx.appcompat.widget.LinearLayoutCompat style="@style/GridRow">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_player_0" style="@style/GridCell" app:srcCompat="@drawable/baby_cry" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_player_1" style="@style/GridCell" app:srcCompat="@drawable/baby_cry" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/main_IMG_player_2" style="@style/GridCell" app:srcCompat="@drawable/baby_cry" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</RelativeLayout>